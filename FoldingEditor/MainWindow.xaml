<Window x:Class="AthleticsCertificateMaker.EditCert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="EditCert - JSON Folding Editor" Height="800" Width="1000">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Name="BtnNew" Click="BtnNew_Click" Content="New" Width="80" Margin="0,0,8,0" />
            <Button Name="BtnLoad" Click="BtnLoad_Click" Content="Load..." Width="80" Margin="0,0,8,0" />
            <Button Name="BtnSave" Click="BtnSave_Click" Content="Save" Width="80" Margin="0,0,8,0" />
            <Button Name="BtnSaveAs" Click="BtnSaveAs_Click" Content="Save As..." Width="100" Margin="0,0,8,0" />
            <TextBlock Name="LblPath" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <avalon:TextEditor Grid.Row="1" Name="Editor" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="LblStatus" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
