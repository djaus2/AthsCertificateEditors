<Window x:Class="AthleticsCertificateMaker.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertificateText Editor" Height="700" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8" Grid.Row="0">
            <Button Name="BtnNew" Click="BtnNew_Click" Content="New" Width="80" Margin="0,0,8,0" />
            <Button Name="BtnLoad" Click="BtnLoad_Click" Content="Load..." Width="80" Margin="0,0,8,0" />
            <Button Name="BtnSave" Click="BtnSave_Click" Content="Save..." Width="80" Margin="0,0,8,0" />
            <Button Name="BtnSaveAs" Click="BtnSaveAs_Click" Content="Save As..." Width="80" />
            <TextBlock Name="LblStatus" Margin="12,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Name="TxtJson"
                 Grid.Row="1"
                 Margin="8"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap" />
    </Grid>
</Window>
