<Window x:Class="AthleticsCertificateMaker.GenerateCertificateApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting Generate Certificate App"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="560" Height="320"
        Topmost="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4FF" Offset="0"/>
            <GradientStop Color="#E08FA8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border CornerRadius="14" Background="White" BorderBrush="#22000000" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="8" Background="#FFF5F5F5">
                    <Image Source="CertificateTemplate.png" Stretch="Uniform" Margin="8"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Generate Certificate App" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Margin="0,8,0,0" Opacity="0.75" FontSize="14"/>
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Opacity="0.85">
Create certificates quickly from participant data and your configured template.
                    </TextBlock>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0" Opacity="0.55" Text="Loading..."/>
        </Grid>
    </Border>
</Window>