<Window x:Class="AthleticsCertificateMaker.GenerateCertificateApp.CertificateViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate Viewer"
        Height="720"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="← Back" Width="90" Click="Back_Click" />
        </StackPanel>

        <TextBlock x:Name="FileNameText"
                   Grid.Row="1"
                   Margin="0,0,0,10"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Background="#11FFFFFF">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="CertificateImage" Stretch="Uniform" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>